# Database (SQLite local por defecto — para producción cambiar a PostgreSQL/MySQL)
DATABASE_URL="file:./db/custom.db"

# NextAuth.js (cuando habilites auth — opcional por ahora)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="genera-con: openssl rand -base64 32"

# z-ai-web-dev-sdk
# El SDK se autoconfigura en entornos Z.ai
# Si lo usas fuera de Z.ai, necesitas configurar las credenciales del SDK aquí
# ZAI_API_KEY=""
